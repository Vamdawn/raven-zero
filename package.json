{
  "name": "raven-zero",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {"node": "24.x"},
  "scripts": {
    "check": "node scripts/check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:mysql-smoke": "tsc -b packages/server && node packages/server/dist/test/mysql_smoke.js",
    "check:mysql-hooks": "node scripts/check_mysql_hooks.mjs",
    "hooks:install": "node scripts/install_hooks.mjs",
    "test:tools": "node --test --test-timeout=60000 scripts/test/*.test.mjs",
    "validation:begin": "node scripts/validation_resources.mjs begin",
    "validation:check": "node scripts/validation_resources.mjs check",
    "build": "pnpm --filter @raven-zero/codex-adapter build:native && tsc -b --force",
    "test": "pnpm build && node --test --test-concurrency=1 --test-timeout=60000 packages/*/dist/test/*.test.js"
  },
  "devDependencies": {"typescript": "7.0.2", "@types/node": "24.19.1"}
}
